{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://digitalmohalla-api.onrender.com",
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true"
      },
      "channel": "preview"
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://digitalmohalla-api.onrender.com",
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
