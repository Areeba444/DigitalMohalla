# Secrets and local env (never commit)
.env
.env.*
!.env.example
*.local

# Docker / infra local overrides
docker-compose.override.yml

# Load-test and experiment scratch output (keep committed results under docs/)
locust_*.csv

# OS / editor
.DS_Store
Thumbs.db
~$*
.idea/
.vscode/

# Claude Code local settings
.claude/settings.local.json

# Data: originals and intermediate files stay local (large, may be licensed). Cards and derived data are committed.
data/raw/*
data/interim/*
!data/raw/.gitkeep
!data/interim/.gitkeep
