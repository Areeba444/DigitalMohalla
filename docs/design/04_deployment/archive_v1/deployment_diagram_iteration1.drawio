        <mxCell id="v14" value="&amp;#171;executionEnvironment&amp;#187; &lt;b&gt;GitHub Actions runner&lt;/b&gt;&lt;br&gt;&amp;#171;artifact&amp;#187; &lt;i&gt;ci.yml&lt;/i&gt; on every push and pull request: Backend (ruff, mypy, bandit, pytest on a PostgreSQL 16 service container), Frontend (tsc, ESLint, Jest), API client in sync" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=14;strokeColor=#5B6B7A;fontColor=#1F2D3A;fillColor=#FFFFFF;" vertex="1" parent="1">
