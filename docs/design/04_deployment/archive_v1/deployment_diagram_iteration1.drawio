        </mxCell>
        <mxCell id="v17" value="&amp;#171;executionEnvironment&amp;#187;&lt;br&gt;&lt;b&gt;Web service&lt;/b&gt; &lt;i&gt;digitalmohalla-api&lt;/i&gt;: Docker container (sleeps after about 15 min idle)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=14;strokeColor=#5B6B7A;fontColor=#1F2D3A;fillColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="50" y="500" width="360" height="410" as="geometry" />
        </mxCell>
        <mxCell id="v18" value="&amp;#171;artifact&amp;#187; &lt;b&gt;API image&lt;/b&gt; (&lt;i&gt;backend/Dockerfile&lt;/i&gt;)&lt;br&gt;Python 3.12, FastAPI + Uvicorn, modular monolith (Modules 1, 3, 5, 9)&lt;br&gt;start-up: &lt;i&gt;alembic upgrade head&lt;/i&gt;, then Uvicorn&lt;br&gt;REST &lt;i&gt;/api/v1&lt;/i&gt;; &lt;i&gt;GET /health&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=24;fontSize=13;fillColor=#FFFFFF;strokeColor=#6A7A8A;fontColor=#1F2D3A;" vertex="1" parent="1">
          <mxGeometry x="66" y="578" width="328" height="162" as="geometry" />
        </mxCell>
