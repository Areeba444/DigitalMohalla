          <mxGeometry x="375" y="759" width="12" height="15" as="geometry" />
        </mxCell>
        <mxCell id="v22" value="Secrets in Render settings: &lt;i&gt;DATABASE_URL&lt;/i&gt;, &lt;i&gt;JWT_SECRET&lt;/i&gt; (generated); &lt;i&gt;CORS_ORIGINS&lt;/i&gt; = the web app only" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=13;spacingLeft=8;spacingTop=4;spacingRight=10;fillColor=#FFF3E0;strokeColor=#C77700;" vertex="1" parent="1">
          <mxGeometry x="66" y="826" width="328" height="72" as="geometry" />
        </mxCell>
        <mxCell id="v23" value="&amp;#171;executionEnvironment&amp;#187;&lt;br&gt;&lt;b&gt;Static site&lt;/b&gt; &lt;i&gt;digitalmohalla-web&lt;/i&gt; on Render's CDN (does not sleep)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=14;strokeColor=#5B6B7A;fontColor=#1F2D3A;fillColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="480" y="500" width="310" height="230" as="geometry" />
        </mxCell>
        <mxCell id="v24" value="&amp;#171;artifact&amp;#187; &lt;b&gt;Expo web export&lt;/b&gt; (&lt;i&gt;frontend/dist&lt;/i&gt;)&lt;br&gt;every path rewritten to &lt;i&gt;index.html&lt;/i&gt;; API address built in" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=24;fontSize=13;fillColor=#FFFFFF;strokeColor=#6A7A8A;fontColor=#1F2D3A;" vertex="1" parent="1">
          <mxGeometry x="496" y="578" width="278" height="136" as="geometry" />
        </mxCell>
        <mxCell id="v25" value="" style="shape=note;size=5;html=1;fillColor=#FFFFFF;strokeColor=#6A7A8A;" vertex="1" parent="1">
          <mxGeometry x="755" y="585" width="12" height="15" as="geometry" />
        </mxCell>
        <mxCell id="v26" value="Render builds &lt;i&gt;main&lt;/i&gt; only after the CI checks pass, and only when &lt;i&gt;backend/&lt;/i&gt; or &lt;i&gt;frontend/&lt;/i&gt; changed. A new API version goes live only if &lt;i&gt;/health&lt;/i&gt; answers; otherwise the previous one stays. Rollback: redeploy an earlier deploy (NFR-D-03, NFR-D-04)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=13;spacingLeft=8;spacingTop=4;spacingRight=10;fillColor=#FFF3E0;strokeColor=#C77700;" vertex="1" parent="1">
          <mxGeometry x="480" y="746" width="310" height="164" as="geometry" />
        </mxCell>
        <mxCell id="v27" value="&amp;#171;cloud service&amp;#187;&lt;br&gt;&lt;b&gt;Neon&lt;/b&gt;" style="shape=cube;whiteSpace=wrap;html=1;size=14;darkOpacity=0.04;darkOpacity2=0.08;align=left;verticalAlign=top;spacingLeft=10;spacingTop=16;fontSize=15;strokeColor=#46535F;fontColor=#1F2D3A;fillColor=#EEF7EE;" vertex="1" parent="1">
          <mxGeometry x="30" y="1010" width="780" height="250" as="geometry" />
        </mxCell>
        <mxCell id="v28" value="free plan, AWS ap-southeast-1 (Singapore), the same region as the API" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=#2E5E1E;spacing=2;overflow=visible;" vertex="1" parent="1">
          <mxGeometry x="250" y="1030" width="540" height="24" as="geometry" />
        </mxCell>
        <mxCell id="v29" value="&amp;#171;executionEnvironment&amp;#187; &lt;b&gt;PostgreSQL 16&lt;/b&gt; with &lt;i&gt;btree_gist&lt;/i&gt;; direct endpoint (not the pooler); suspends when idle, wakes on connect" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=14;strokeColor=#5B6B7A;fontColor=#1F2D3A;fillColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="50" y="1074" width="740" height="170" as="geometry" />
        </mxCell>
        <mxCell id="v30" value="&amp;#171;artifact&amp;#187; &lt;b&gt;schema &lt;i&gt;dm&lt;/i&gt;&lt;/b&gt; v2.3 (Alembic migration 0001): event store (append-only, hash-chained), projections, bookings (EXCLUDE), assessments, cases, moderator decisions, audit log. No coordinates, addresses or CNIC (suite 14)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=24;fontSize=13;fillColor=#FFFFFF;strokeColor=#6A7A8A;fontColor=#1F2D3A;" vertex="1" parent="1">
          <mxGeometry x="66" y="1132" width="708" height="96" as="geometry" />
        </mxCell>
        <mxCell id="v31" value="" style="shape=note;size=5;html=1;fillColor=#FFFFFF;strokeColor=#6A7A8A;" vertex="1" parent="1">
          <mxGeometry x="755" y="1139" width="12" height="15" as="geometry" />
        </mxCell>
        <mxCell id="v32" value="&amp;#171;device&amp;#187;&lt;br&gt;&lt;b&gt;Team laptop&lt;/b&gt;: development and demo fallback" style="shape=cube;whiteSpace=wrap;html=1;size=14;darkOpacity=0.04;darkOpacity2=0.08;align=left;verticalAlign=top;spacingLeft=10;spacingTop=16;fontSize=15;strokeColor=#46535F;fontColor=#1F2D3A;fillColor=#F1F1F1;" vertex="1" parent="1">
          <mxGeometry x="850" y="620" width="360" height="230" as="geometry" />
        </mxCell>
        <mxCell id="v33" value="&amp;#171;executionEnvironment&amp;#187; &lt;b&gt;local run&lt;/b&gt;&lt;br&gt;PostgreSQL 16, Uvicorn API, Expo dev server; synthetic seed data. Used if the hosted service is unavailable during the demo." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=14;strokeColor=#5B6B7A;fontColor=#1F2D3A;fillColor=#FAFAFA;" vertex="1" parent="1">
          <mxGeometry x="870" y="688" width="320" height="144" as="geometry" />
        </mxCell>
        <mxCell id="v34" value="&lt;b&gt;Planned, not built yet&lt;/b&gt; (Iteration 2): Android release build with the API address (EAS, TC-73); post-deploy smoke test (TC-91); rehearsed rollback; a paid tier or small host for the pilot if free-tier sleep affects users." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=13;spacingLeft=8;spacingTop=4;spacingRight=10;dashed=1;fillColor=#F4F4F4;strokeColor=#7A7A7A;fontColor=#3A3A3A;" vertex="1" parent="1">
          <mxGeometry x="850" y="878" width="360" height="160" as="geometry" />
        </mxCell>
        <mxCell id="v35" value="&lt;b&gt;Why&lt;/b&gt;: managed services give HTTPS, TLS to the database, health-gated deploys and rollback without server administration. Serves NFR-S-01, NFR-D-03, NFR-D-04, NFR-PR-01, NFR-S-07. The Part A design (one AWS host) is kept for reference." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=13;spacingLeft=8;spacingTop=4;spacingRight=10;fillColor=#FFFFFF;strokeColor=#B0BAC4;" vertex="1" parent="1">
          <mxGeometry x="850" y="1062" width="360" height="198" as="geometry" />
        </mxCell>
        <mxCell id="e36" value="HTTPS :443&lt;br&gt;REST /api/v1 (JSON)" style="html=1;rounded=0;fontSize=10.5;labelBackgroundColor=#FFFFFF;fontColor=#1d1d1d;endSize=8;endArrow=none;strokeColor=#2F4F6F;strokeWidth=1.6;fontSize=13;;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.4722;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0" edge="1" parent="1" source="v3" target="v17">
