          <mxGeometry x="375" y="585" width="12" height="15" as="geometry" />
        </mxCell>
        <mxCell id="v20" value="&amp;#171;artifact&amp;#187; &lt;i&gt;config/engine.json&lt;/i&gt;&lt;br&gt;config_version 1.3.0-iteration1-draft" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=24;fontSize=13;fillColor=#FFFFFF;strokeColor=#6A7A8A;fontColor=#1F2D3A;" vertex="1" parent="1">
          <mxGeometry x="66" y="752" width="328" height="62" as="geometry" />
