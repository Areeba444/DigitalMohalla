        <mxCell id="v12" value="&amp;#171;artifact&amp;#187; &lt;b&gt;repository&lt;/b&gt; Areeba444/DigitalMohalla&lt;br&gt;&lt;i&gt;main&lt;/i&gt; = deployed, &lt;i&gt;develop&lt;/i&gt; = integration; &lt;i&gt;render.yaml&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=24;fontSize=13;fillColor=#FFFFFF;strokeColor=#6A7A8A;fontColor=#1F2D3A;" vertex="1" parent="1">
