        <mxCell id="v16" value="free plan, region Singapore;&lt;br&gt;HTTPS :443 ends at Render's edge&lt;br&gt;(NFR-S-01)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=#8A4B12;spacing=2;overflow=visible;" vertex="1" parent="1">
