        <mxCell id="v1" value="&lt;b&gt;Digital Mohalla &amp;#8212; Sequence diagram (h): appeal, second moderator, reversal and flagged evidence&lt;/b&gt; &amp;#8212; DA-12, Student 3, v1.0 draft (iteration 2)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontStyle=0;fontColor=#1d1d1d;spacing=2;overflow=visible;" vertex="1" parent="1">
          <mxGeometry x="30" y="12" width="1650" height="24" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="Precondition: the case is DECIDED (C06) and its decision is stored in moderator_decision. A reversal never rewinds a closed loan: COMPLETED, DECLINED and NO_SHOW are final lifecycle states. It changes the evidence instead, so the next assessment of either party sees the corrected record (ES-11). Endpoints are proposals for the DA-10 REST table; the appeal window is a config value (DA-03)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#4A5560;spacing=2;overflow=visible;" vertex="1" parent="1">
          <mxGeometry x="30" y="36" width="1650" height="34" as="geometry" />
        </mxCell>
