        <mxCell id="e36" value="&lt;b&gt;25&lt;/b&gt; INSERT moderator_decision(kind = REVERSAL, reverses_decision_id); UPDATE status = REVERSED" style="html=1;rounded=0;fontSize=10.5;labelBackgroundColor=#FFFFFF;fontColor=#1d1d1d;endSize=8;endArrow=block;endFill=1;strokeColor=#1D1D1D;fontSize=10.5" edge="1" parent="1">
