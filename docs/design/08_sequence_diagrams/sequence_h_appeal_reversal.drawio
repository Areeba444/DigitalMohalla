          </mxGeometry>
        </mxCell>
        <mxCell id="e37" value="&lt;b&gt;26&lt;/b&gt; flagOutcomes(decision) and refresh trust edges, as in step 2" style="html=1;rounded=0;fontSize=10.5;labelBackgroundColor=#FFFFFF;fontColor=#1d1d1d;endSize=8;endArrow=block;endFill=1;strokeColor=#1D1D1D;fontSize=10.5" edge="1" parent="1">
