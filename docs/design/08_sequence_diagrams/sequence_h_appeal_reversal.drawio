        </mxCell>
        <mxCell id="e39" value="&lt;b&gt;28&lt;/b&gt; notify(both parties, decision_reversed, {case, reason})" style="html=1;rounded=0;fontSize=10.5;labelBackgroundColor=#FFFFFF;fontColor=#1d1d1d;endSize=8;endArrow=open;endFill=0;strokeColor=#1D1D1D;fontSize=10.5" edge="1" parent="1">
