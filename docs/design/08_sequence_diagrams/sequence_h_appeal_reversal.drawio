        </mxCell>
        <mxCell id="e38" value="&lt;b&gt;27&lt;/b&gt; record(decision_reversed, case, actor, authorisation)" style="html=1;rounded=0;fontSize=10.5;labelBackgroundColor=#FFFFFF;fontColor=#1d1d1d;endSize=8;endArrow=block;endFill=1;strokeColor=#1D1D1D;fontSize=10.5" edge="1" parent="1">
