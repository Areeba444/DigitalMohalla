        <mxCell id="e40" value="&lt;b&gt;29&lt;/b&gt; 200 {status: REVERSED, flagged_outcomes: n}" style="html=1;rounded=0;fontSize=10.5;labelBackgroundColor=#FFFFFF;fontColor=#1d1d1d;endSize=8;endArrow=open;endFill=0;dashed=1;strokeColor=#46535F;fontColor=#33404D;fontSize=10.5" edge="1" parent="1">
