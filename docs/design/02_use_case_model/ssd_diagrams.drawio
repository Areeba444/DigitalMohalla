  <diagram name="SSD-B7-B8 Handover and return" id="SSDB7B8Handoverandre">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1210" pageHeight="2103" math="0" shadow="0">
      <root>
