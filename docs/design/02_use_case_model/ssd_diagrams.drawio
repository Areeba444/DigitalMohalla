  <diagram name="SSD-I4 Resolve escalated case or dispute" id="SSDI4Resolveescalate">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1260" pageHeight="1541" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n1" value="&lt;b&gt;SSD-I4: Resolve escalated case or dispute&lt;/b&gt;&lt;br&gt;&lt;b&gt;Document:&lt;/b&gt; behaviour design, step A9 (S3)&lt;br&gt;&lt;b&gt;Version:&lt;/b&gt; 1.0; &lt;b&gt;Date:&lt;/b&gt; 2026-10-11&lt;br&gt;&lt;b&gt;Author:&lt;/b&gt; Student 3 (S3), drafted with Claude; reviewed by: ______&lt;br&gt;&lt;b&gt;Status:&lt;/b&gt; Draft for design gate A14&lt;br&gt;&lt;b&gt;Based on:&lt;/b&gt; Use Cases v1.3 (UC-I4, with D6), FR/NFR v1.3, ADR-0003, ADR-0004&lt;br&gt;&lt;b&gt;Package:&lt;/b&gt; Module 9 (cases and decisions)" style="rounded=0;fillColor=#fffbe6;strokeColor=#999999;html=1;verticalAlign=top;align=left;spacing=8;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="10" y="10" width="400" height="200" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;FRs realised:&lt;/b&gt; FR-T-11 (also FR-T-10 for the case, FR-B-08 for the resulting state).&lt;br&gt;&lt;b&gt;Rationale:&lt;/b&gt; The moderator works on one case at a time, so the SSD shows opening, an optional request for more information, a decision and a confirmation. The decision step has three outcomes (rejected, escalated to Admin, accepted for confirmation), and the confirmation then branches by case type, following the exit rules of ADR-0004 for disputes and ADR-0003 for holds. The hold reason decides whether a hold returns to LOCALITY_CHECKED or ASSESSED, so it is part of what the system shows at step 1.&lt;br&gt;&lt;b&gt;Not shown:&lt;/b&gt; Appeal to a second moderator (4b) and later reversal (4c) belong to the case state machine (A3). Engine-failure holds cannot take safeguards (3c, ADR-0003)." style="rounded=0;fillColor=#fffbe6;strokeColor=#999999;html=1;verticalAlign=top;align=left;spacing=8;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="420" y="10" width="490" height="200" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;Legend&lt;/b&gt; (UML 2.5.1 sequence notation; SSD convention after Larman)&lt;br&gt;Stick figure: actor outside the system. Box: the system as one black box, no internals.&lt;br&gt;Solid line, filled head: system event. Dashed line, open head: return. Solid line, open head: asynchronous notification.&lt;br&gt;alt / opt / par / ref: combined fragments. Replies that carry no data are omitted. Numbers follow the use case steps; the right margin gives the step or extension." style="rounded=0;fillColor=#ffffff;strokeColor=#999999;html=1;verticalAlign=top;align=left;spacing=8;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1">
