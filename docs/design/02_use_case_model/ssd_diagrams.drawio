  <diagram name="SSD-B12 Raise a dispute" id="SSDB12Raiseadispute">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1400" pageHeight="1287" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n1" value="&lt;b&gt;SSD-B12: Raise a dispute on a booking&lt;/b&gt;&lt;br&gt;&lt;b&gt;Document:&lt;/b&gt; behaviour design, step A9 (S3)&lt;br&gt;&lt;b&gt;Version:&lt;/b&gt; 1.0; &lt;b&gt;Date:&lt;/b&gt; 2026-10-11&lt;br&gt;&lt;b&gt;Author:&lt;/b&gt; Student 3 (S3), drafted with Claude; reviewed by: ______&lt;br&gt;&lt;b&gt;Status:&lt;/b&gt; Draft for design gate A14&lt;br&gt;&lt;b&gt;Based on:&lt;/b&gt; Use Cases v1.3 (UC-B12, with D6), FR/NFR v1.3, ADR-0004&lt;br&gt;&lt;b&gt;Package:&lt;/b&gt; Module 3 (borrowing lifecycle); case creation in Module 9" style="rounded=0;fillColor=#fffbe6;strokeColor=#999999;html=1;verticalAlign=top;align=left;spacing=8;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="10" y="10" width="400" height="200" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;FRs realised:&lt;/b&gt; FR-B-16, FR-B-17 (also FR-B-08, FR-T-10 for the case).&lt;br&gt;&lt;b&gt;Rationale:&lt;/b&gt; The raising party's three steps (select, choose reason, submit) are separate system events because the system checks the window at the first and freezes the booking only at the last. The notifications to the other party and the moderator are asynchronous, so the other party's response and the no-response case follow in an alt frame, as FR-B-17 requires. Withdrawal is an opt frame that restores the stored previous state (dispute_withdrawn, ADR-0004).&lt;br&gt;&lt;b&gt;Not shown:&lt;/b&gt; UC-B12 *a (party abandons the form before submitting) creates nothing, so it has no message." style="rounded=0;fillColor=#fffbe6;strokeColor=#999999;html=1;verticalAlign=top;align=left;spacing=8;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="420" y="10" width="630" height="200" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;Legend&lt;/b&gt; (UML 2.5.1 sequence notation; SSD convention after Larman)&lt;br&gt;Stick figure: actor outside the system. Box: the system as one black box, no internals.&lt;br&gt;Solid line, filled head: system event. Dashed line, open head: return. Solid line, open head: asynchronous notification.&lt;br&gt;alt / opt / par / ref: combined fragments. Replies that carry no data are omitted. Numbers follow the use case steps; the right margin gives the step or extension." style="rounded=0;fillColor=#ffffff;strokeColor=#999999;html=1;verticalAlign=top;align=left;spacing=8;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1060" y="10" width="330" height="200" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="Raising party&#10;(lender or borrower)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="155" y="235" width="30" height="56" as="geometry" />
        </mxCell>
        <mxCell id="n5" value=":Digital Mohalla" style="rounded=0;fillColor=#dae8fc;strokeColor=#000000;html=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="475" y="249" width="170" height="44" as="geometry" />
        </mxCell>
