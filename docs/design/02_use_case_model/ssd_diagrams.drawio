<mxfile host="app.diagrams.net">
  <diagram name="SSD-B5 Send borrowing request" id="SSDB5Sendborrowingre">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1190" pageHeight="1193" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n1" value="&lt;b&gt;SSD-B5: Send borrowing request&lt;/b&gt;&lt;br&gt;&lt;b&gt;Document:&lt;/b&gt; behaviour design, step A9 (S3)&lt;br&gt;&lt;b&gt;Version:&lt;/b&gt; 1.0; &lt;b&gt;Date:&lt;/b&gt; 2026-10-11&lt;br&gt;&lt;b&gt;Author:&lt;/b&gt; Student 3 (S3), drafted with Claude; reviewed by: ______&lt;br&gt;&lt;b&gt;Status:&lt;/b&gt; Draft for design gate A14&lt;br&gt;&lt;b&gt;Based on:&lt;/b&gt; Use Cases v1.3 (UC-B5), FR/NFR v1.3, ADR-0001, ADR-0003&lt;br&gt;&lt;b&gt;Package:&lt;/b&gt; Module 3 (borrowing lifecycle)" style="rounded=0;fillColor=#fffbe6;strokeColor=#999999;html=1;verticalAlign=top;align=left;spacing=8;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="10" y="10" width="400" height="200" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;FRs realised:&lt;/b&gt; FR-B-05, FR-B-06, FR-B-07, FR-B-08, FR-B-09.&lt;br&gt;&lt;b&gt;Rationale:&lt;/b&gt; The system is drawn as one black box, so the locality check, the assessment and the hold decision appear only as the state that submitRequest returns. The first three alt frames are the extensions that stop a request early (1a, 2a, 3a and 3b), and the nested alt separates the two outcomes of steps 4 and 5. Pending requests only mark dates (ADR-0001), so no message blocks the calendar. The system events named here are the operations that sequence (a) and the REST table (A8) must provide.&lt;br&gt;&lt;b&gt;Not shown:&lt;/b&gt; UC-B5 *a (borrower cancels before sending) creates nothing, so it has no message. UC-B5 does not say what the borrower is told on a hold, so only the state is shown." style="rounded=0;fillColor=#fffbe6;strokeColor=#999999;html=1;verticalAlign=top;align=left;spacing=8;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="420" y="10" width="420" height="200" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;Legend&lt;/b&gt; (UML 2.5.1 sequence notation; SSD convention after Larman)&lt;br&gt;Stick figure: actor outside the system. Box: the system as one black box, no internals.&lt;br&gt;Solid line, filled head: system event. Dashed line, open head: return. Solid line, open head: asynchronous notification.&lt;br&gt;alt / opt / par / ref: combined fragments. Replies that carry no data are omitted. Numbers follow the use case steps; the right margin gives the step or extension." style="rounded=0;fillColor=#ffffff;strokeColor=#999999;html=1;verticalAlign=top;align=left;spacing=8;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="850" y="10" width="330" height="200" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="Borrower" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="145" y="235" width="30" height="56" as="geometry" />
        </mxCell>
        <mxCell id="n5" value=":Digital Mohalla" style="rounded=0;fillColor=#dae8fc;strokeColor=#000000;html=1;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1">
