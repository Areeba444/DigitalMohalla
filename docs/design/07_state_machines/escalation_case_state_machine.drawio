        <mxCell id="e8" value="the loan left the trigger state&lt;br&gt;without a decision: dispute_withdrawn,&lt;br&gt;request_cancelled, request_declined&lt;br&gt;(dates taken) / close &amp;nbsp;&lt;b&gt;C07&lt;/b&gt;" style="html=1;rounded=0;fontSize=10.5;labelBackgroundColor=#FFFFFF;fontColor=#1d1d1d;endSize=8;strokeColor=#5F6B76;fontColor=#5F6B76;endArrow=open;endFill=0;strokeWidth=1.6;dashed=1;dashPattern=6 3;;exitX=1;exitY=0.8828125;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0" edge="1" parent="1" source="UNDECIDED" target="WITHDRAWN">
