        <mxCell id="e10" value="decision_reversed [another moderator&lt;br&gt;or admin; reason] / both decisions&lt;br&gt;kept in the log (FR-A-11) &amp;nbsp;&lt;b&gt;M08&lt;/b&gt;" style="html=1;rounded=0;fontSize=10.5;labelBackgroundColor=#FFFFFF;fontColor=#1d1d1d;endSize=8;strokeColor=#7B3FA0;fontColor=#7B3FA0;endArrow=open;endFill=0;strokeWidth=1.6;;exitX=0.5;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0" edge="1" parent="1" source="REJECTED" target="APPROVED">
          <mxGeometry relative="1" as="geometry">
