        <mxCell id="e3" value="join_requested [contact verified; no live membership&lt;br&gt;in this community; community active; invitation&lt;br&gt;code valid] / one coarse GPS check and the invitation&lt;br&gt;evaluated in memory; coordinates discarded &amp;nbsp;&lt;b&gt;M01&lt;/b&gt;" style="html=1;rounded=0;fontSize=10.5;labelBackgroundColor=#FFFFFF;fontColor=#1d1d1d;endSize=8;strokeColor=#1F5FA8;fontColor=#1F5FA8;endArrow=open;endFill=0;strokeWidth=1.6;;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0" edge="1" parent="1" source="m_init" target="PENDING">
