        <mxCell id="m_init" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="UNDECIDED">
          <mxGeometry x="215" y="35" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="PENDING" value="&lt;b&gt;PENDING&lt;/b&gt;&lt;hr style='margin:3px 0'&gt;&lt;span style='font-size:10px'&gt;entry / store the coarse locality result only:&lt;br&gt;VERIFIED, INCONCLUSIVE or CONFLICTING (A11);&lt;br&gt;attach duplicate-account and mismatch flags;&lt;br&gt;notify the community's moderators&lt;br&gt;do / wait in the moderator queue (UC-A4 step 1)&lt;/span&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B3A4A;fontSize=12;fontColor=#1D1D1D;verticalAlign=middle;" vertex="1" parent="UNDECIDED">
          <mxGeometry x="50" y="145" width="370" height="118" as="geometry" />
        </mxCell>
        <mxCell id="AWAITING_INFORMATION" value="&lt;b&gt;AWAITING_INFORMATION&lt;/b&gt;&lt;hr style='margin:3px 0'&gt;&lt;span style='font-size:10px'&gt;entry / notify the applicant; set the response&lt;br&gt;deadline (window in config, DA-03)&lt;br&gt;(UC-A4 2a)&lt;/span&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B3A4A;fontSize=12;fontColor=#1D1D1D;verticalAlign=middle;" vertex="1" parent="UNDECIDED">
          <mxGeometry x="50" y="430" width="370" height="90" as="geometry" />
        </mxCell>
        <mxCell id="APPROVED" value="&lt;b&gt;APPROVED&lt;/b&gt;&lt;hr style='margin:3px 0'&gt;&lt;span style='font-size:10px'&gt;entry / role := MEMBER; decided_at := now;&lt;br&gt;audit entry; notify the applicant;&lt;br&gt;MODERATOR_APPROVAL locality result if&lt;br&gt;the outcome was not VERIFIED (A11)&lt;br&gt;The member can now borrow in this&lt;br&gt;community (txn_guard_create, G1)&lt;/span&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B3A4A;fontSize=12;fontColor=#1D1D1D;verticalAlign=middle;fillColor=#EAF2FB;strokeColor=#1F5FA8;strokeWidth=2.5;" vertex="1" parent="1">
          <mxGeometry x="760" y="150" width="300" height="126" as="geometry" />
