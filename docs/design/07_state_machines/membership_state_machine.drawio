        <mxCell id="e11" value="auto_approved [join_policy = OPEN;&lt;br&gt;locality outcome VERIFIED] / role := MEMBER;&lt;br&gt;notify the moderators (UC-A3 4a) &amp;nbsp;&lt;b&gt;M09&lt;/b&gt;" style="html=1;rounded=0;fontSize=10.5;labelBackgroundColor=#FFFFFF;fontColor=#1d1d1d;endSize=8;strokeColor=#5F6B76;fontColor=#5F6B76;endArrow=open;endFill=0;strokeWidth=1.6;dashed=1;dashPattern=6 3;;exitX=1;exitY=0.3813559322033898;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.7936507936507936;entryDx=0;entryDy=0;entryPerimeter=0" edge="1" parent="1" source="PENDING" target="APPROVED">
          <mxGeometry relative="1" as="geometry" x="-0.30">
            <Array as="points">
              <mxPoint x="700" y="300" />
              <mxPoint x="700" y="250" />
            </Array>
            <mxPoint x="0" y="40" as="offset" />
