        <mxCell id="REJECTED" value="&lt;b&gt;REJECTED&lt;/b&gt;&lt;hr style='margin:3px 0'&gt;&lt;span style='font-size:10px'&gt;entry / reason recorded; audit entry;&lt;br&gt;notify the applicant&lt;/span&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B3A4A;fontSize=12;fontColor=#1D1D1D;verticalAlign=middle;" vertex="1" parent="1">
