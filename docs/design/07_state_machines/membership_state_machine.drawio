        <mxCell id="e13" value="" style="html=1;rounded=0;fontSize=10.5;labelBackgroundColor=#FFFFFF;fontColor=#1d1d1d;endSize=8;strokeColor=#5F6B76;fontColor=#5F6B76;endArrow=open;endFill=0;strokeWidth=1.6;dashed=1;dashPattern=6 3;;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0" edge="1" parent="1" source="REVOKED" target="fin_r">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note_db" value="&lt;b&gt;Database rules this machine relies on&lt;/b&gt;&lt;br&gt;&amp;#8226; &lt;i&gt;membership_decided_ck&lt;/i&gt;: decided_at is null exactly while the status is PENDING or&lt;br&gt;&amp;nbsp;&amp;nbsp;AWAITING_INFORMATION, so every exit from UNDECIDED sets it.&lt;br&gt;&amp;#8226; &lt;i&gt;membership_one_live_uq&lt;/i&gt;: at most one PENDING, AWAITING_INFORMATION or APPROVED&lt;br&gt;&amp;nbsp;&amp;nbsp;row per user and community (UC-A3 4b). A rejected, withdrawn or revoked applicant&lt;br&gt;&amp;nbsp;&amp;nbsp;may apply again: that is a new row and a new M01 (UC-A4 4d).&lt;br&gt;&amp;#8226; No column stores coordinates or an address (NFR-PR-01); locality_verification keeps&lt;br&gt;&amp;nbsp;&amp;nbsp;only the coarse outcome and signal." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFDF2;strokeColor=#B8A660;fontSize=10.5;fontColor=#33404D;" vertex="1" parent="1">
          <mxGeometry x="1100" y="430" width="380" height="200" as="geometry" />
        </mxCell>
        <mxCell id="note_open" value="&lt;b&gt;Open points (to settle in DA-03 / decision record)&lt;/b&gt;&lt;br&gt;&amp;#8226; Open-join communities (UC-A3 4a, issue I-10): settled by schema v2.4,&lt;br&gt;&amp;nbsp;&amp;nbsp;community.join_policy; only a VERIFIED result is approved by itself (M09).&lt;br&gt;&amp;#8226; Response deadline value for M02/M03 (DA-03).&lt;br&gt;&amp;#8226; Granting the MODERATOR role is an admin action (FR-M-01), not part of this machine." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFDF2;strokeColor=#B8A660;fontSize=10.5;fontColor=#33404D;" vertex="1" parent="1">
          <mxGeometry x="1100" y="650" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;span style='color:#1F5FA8'&gt;&amp;#9472;&amp;#9472;&amp;#9658;&lt;/span&gt; applicant (member) &amp;nbsp; &lt;span style='color:#7B3FA0'&gt;&amp;#9472;&amp;#9472;&amp;#9658;&lt;/span&gt; moderator or admin &amp;nbsp; &lt;span style='color:#5F6B76'&gt;- - &amp;#9658;&lt;/span&gt; system or completion&lt;br&gt;event [guard] / effect; blue border = live membership; bold border = final state.&lt;br&gt;Membership changes are not lifecycle events: each one is an audit_log entry (FR-M-05)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#9AA5B1;fontSize=10.5;fontColor=#33404D;" vertex="1" parent="1">
          <mxGeometry x="40" y="820" width="700" height="72" as="geometry" />
        </mxCell>
