        <mxCell id="v1" value="&lt;b&gt;Digital Mohalla &amp;#8212; Membership state machine&lt;/b&gt; (Membership, design artefact DA-08, v1.1, iteration 2)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontStyle=0;fontColor=#1d1d1d;spacing=2;overflow=visible;" vertex="1" parent="1">
          <mxGeometry x="40" y="12" width="1100" height="24" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="States are the six values of &lt;i&gt;membership_status&lt;/i&gt; (schema v2.3). Sources: UC-A3, UC-A4, FR-A-08 to FR-A-11, FR-M-01, locality design A11, schema v2.4 (community.join_policy). Transition IDs M01&amp;#8211;M09 are rows of the table in Membership_State_Machine.md." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#4A5560;spacing=2;overflow=visible;" vertex="1" parent="1">
          <mxGeometry x="40" y="36" width="1300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="UNDECIDED" value="UNDECIDED &amp;nbsp;&lt;span style='font-weight:normal;font-size:11px'&gt;(request open, decided_at is null)&lt;/span&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=3;fontStyle=1;fontSize=13;fillColor=#F7F9FC;strokeColor=#7A8A9A;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="470" height="560" as="geometry" />
