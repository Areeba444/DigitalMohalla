        <mxCell id="e8" value="withdrawn [applicant]&lt;br&gt;/ decided_at := now &amp;nbsp;&lt;b&gt;M06&lt;/b&gt;" style="html=1;rounded=0;fontSize=10.5;labelBackgroundColor=#FFFFFF;fontColor=#1d1d1d;endSize=8;strokeColor=#1F5FA8;fontColor=#1F5FA8;endArrow=open;endFill=0;strokeWidth=1.6;;exitX=1;exitY=1.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0" edge="1" parent="1" source="UNDECIDED" target="WITHDRAWN">
