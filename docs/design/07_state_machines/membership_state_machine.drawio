        <mxCell id="e6" value="approved [moderator of this community, not the&lt;br&gt;applicant; reason; applicant active (A4 4c);&lt;br&gt;still undecided (A4 4a)] &amp;nbsp;&lt;b&gt;M04&lt;/b&gt;" style="html=1;rounded=0;fontSize=10.5;labelBackgroundColor=#FFFFFF;fontColor=#1d1d1d;endSize=8;strokeColor=#7B3FA0;fontColor=#7B3FA0;endArrow=open;endFill=0;strokeWidth=1.6;;exitX=1;exitY=0.16964285714285715;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0" edge="1" parent="1" source="UNDECIDED" target="APPROVED">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="0" y="-34" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e7" value="rejected [same guards; reason].&lt;br&gt;An INCONCLUSIVE or CONFLICTING&lt;br&gt;result never rejects by itself&lt;br&gt;(FR-A-08) &amp;nbsp;&lt;b&gt;M05&lt;/b&gt;" style="html=1;rounded=0;fontSize=10.5;labelBackgroundColor=#FFFFFF;fontColor=#1d1d1d;endSize=8;strokeColor=#7B3FA0;fontColor=#7B3FA0;endArrow=open;endFill=0;strokeWidth=1.6;;exitX=1;exitY=0.6428571428571429;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0" edge="1" parent="1" source="UNDECIDED" target="REJECTED">
