        <mxCell id="v1" value="&lt;b&gt;Digital Mohalla &amp;#8212; Class diagram of the whole system&lt;/b&gt; (design step A7 v1.0; iteration 2 v3.0, DA-11): Modules 1, 3, 4, 5, 7, 9 and 10, all three students" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontStyle=0;fontColor=#1d1d1d;spacing=2;overflow=visible;" vertex="1" parent="1">
          <mxGeometry x="40" y="12" width="3000" height="24" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="Python design classes. Colour = owner: &lt;span style='background:#E3EEF9'&gt;&amp;nbsp;S1 Fatima&amp;nbsp;&lt;/span&gt; &lt;span style='background:#FDEBDD'&gt;&amp;nbsp;S2 Areeba&amp;nbsp;&lt;/span&gt; &lt;span style='background:#EEE5F6'&gt;&amp;nbsp;S3 Minahil&amp;nbsp;&lt;/span&gt;. &lt;font color='#0A7A36'&gt;&lt;b&gt;Green text&lt;/b&gt; = added or changed in iteration 2; &lt;b&gt;green border&lt;/b&gt; = class new in iteration 2.&lt;/font&gt; Each class names the FRs it realises; a dependency on another module is the interface named in the attribute or operation (module dependencies: component diagram)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#4A5560;spacing=2;overflow=visible;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="4400" height="22" as="geometry" />
        </mxCell>
