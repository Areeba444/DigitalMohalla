        <mxCell id="e5" value="" style="html=1;rounded=0;fontSize=10.5;labelBackgroundColor=#FFFFFF;fontColor=#1d1d1d;endSize=8;endArrow=none;startArrow=diamondThin;startFill=1;startSize=14;strokeColor=#2B3A4A;strokeWidth=1.3;;exitX=0;exitY=0.92;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0" edge="1" parent="1" source="a_c_Txn" target="b_Ctr">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1104" y="341.36" />
