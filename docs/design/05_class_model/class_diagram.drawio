        <mxCell id="a_c_Svc_body" value="- store: EventStore&lt;br&gt;- validator: TransitionValidator&lt;br&gt;- engine: AssuranceEngine&lt;br&gt;- locality: LocalityChecker&lt;br&gt;- outcomes: OutcomeSink&lt;br&gt;&lt;font color='#0A7A36'&gt;- notify: INotify&lt;/font&gt;&lt;hr style='margin:3px 0'&gt;create_request(cmd: CreateRequest): BorrowingTransaction&lt;br&gt;accept(id, actor) / decline(id, actor, reason)&lt;br&gt;cancel(id, actor)&lt;br&gt;record_handover_checklist(id, actor, report)&lt;br&gt;confirm_handover(id, actor, agreed)&lt;br&gt;initiate_return(id, actor)&lt;br&gt;confirm_return(id, actor, report)&lt;br&gt;open_dispute(id, actor, reason) / withdraw_dispute(id, actor)&lt;br&gt;apply_decision(id, decision: ModeratorDecision)&lt;br&gt;&lt;font color='#0A7A36'&gt;counter_offer(id, lender, period)  # I07&lt;/font&gt;&lt;br&gt;&lt;font color='#0A7A36'&gt;respond_counter(id, borrower, accept)  # T29 / I08&lt;/font&gt;&lt;br&gt;&lt;font color='#0A7A36'&gt;request_extension(id, borrower, new_due)  # I03&lt;/font&gt;&lt;br&gt;&lt;font color='#0A7A36'&gt;respond_extension(id, lender, approve)  # I04 / I05&lt;/font&gt;&lt;br&gt;&lt;font color='#0A7A36'&gt;expire(id) / no_show(id) / remind(id, step)  # scheduler&lt;/font&gt;&lt;br&gt;&lt;font color='#0A7A36'&gt;escalate_overdue(id)  # T24&lt;/font&gt;&lt;hr style='margin:3px 0'&gt;&lt;i style='color:#6A7A8A'&gt;FR-B-05 to B-07, B-10 to B-18&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10.5;whiteSpace=wrap;overflow=hidden;" vertex="1" parent="a_c_Svc">
