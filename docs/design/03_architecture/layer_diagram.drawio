        <mxCell id="v2" value="Same layer rules as iteration 1: each upper layer uses only the layer below it; the domain layer has no I/O; infrastructure implements the ports declared in the application layer. Iteration 2 adds, in green, the search, membership, notification and scheduler parts." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#4A5560;spacing=2;overflow=visible;" vertex="1" parent="1">
