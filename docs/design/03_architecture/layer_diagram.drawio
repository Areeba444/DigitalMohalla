        </mxCell>
        <mxCell id="v2" value="Strict layering: each layer depends only on the layer directly below it. The domain layer has no I/O; repositories are interfaces in the application layer, implemented in infrastructure (dependency inversion)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#4A5560;spacing=2;overflow=visible;" vertex="1" parent="1">
