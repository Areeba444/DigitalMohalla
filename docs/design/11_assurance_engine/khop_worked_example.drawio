        <mxCell id="e16" value="0.80 (3&amp;#10003;) B&amp;#8594;A: not on any simple L&amp;#8594;B path" style="html=1;rounded=0;fontSize=10.5;labelBackgroundColor=#FFFFFF;fontColor=#1d1d1d;endSize=8;endArrow=block;endFill=1;strokeColor=#9AA4AE;fontColor=#9AA4AE;strokeWidth=1.2;dashed=1;;exitX=0.5;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0" edge="1" parent="1" source="B" target="A">
