        <mxCell id="priv_line" value="" style="endArrow=none;html=1;strokeColor=#dc2626;strokeWidth=3;dashed=1;dashPattern=8 8;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="380" y="80" as="sourcePoint" />
            <mxPoint x="380" y="1080" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="priv_banner" value="&lt;b&gt;CRITICAL PRIVACY BOUNDARY (A11, FR-A-07, NFR-PR-01)&lt;/b&gt;&lt;br/&gt;A device location exists only in memory in the Locality Service, once, when a member joins (UC-A3).&#10;Only the stored coarse outcome and the sanitised request context cross this line; no coordinates reach Module 5 or any store" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=2;fontColor=#991b1b;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
