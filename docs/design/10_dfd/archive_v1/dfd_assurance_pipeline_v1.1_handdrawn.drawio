          <mxGeometry x="40" y="240" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ent_admin" value="&lt;b&gt;System&lt;br/&gt;Administrator&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;strokeWidth=2;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ent_lender" value="&lt;b&gt;Lender&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;strokeWidth=2;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1410" y="790" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ent_mod" value="&lt;b&gt;Community&lt;br/&gt;Moderator&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;strokeWidth=2;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1410" y="380" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="&lt;b&gt;1.0&lt;/b&gt;&lt;br/&gt;Receive Request &amp;amp;&lt;br/&gt;Check Stored Locality&lt;br/&gt;&lt;i&gt;(Lifecycle + Locality Service)&lt;/i&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=3;fontColor=#991b1b;fontSize=12;" vertex="1" parent="1">
