        <mxCell id="v24" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Header colour = module: &lt;span style='background:#DCE8F5'&gt;&amp;nbsp;1 Accounts &amp;amp; communities&amp;nbsp;&lt;/span&gt; &lt;span style='background:#E2F0D9'&gt;&amp;nbsp;3 Borrowing lifecycle&amp;nbsp;&lt;/span&gt; &lt;span style='background:#FCE9D9'&gt;&amp;nbsp;5 Assurance&amp;nbsp;&lt;/span&gt; &lt;span style='background:#EDE3F5'&gt;&amp;nbsp;9 Moderation &amp;amp; audit&amp;nbsp;&lt;/span&gt; &lt;span style='background:#EEEEEE'&gt;&amp;nbsp;reference data&amp;nbsp;&lt;/span&gt;&lt;br&gt;&amp;#171;Class&amp;#187; = domain-model class (A2) the table realises. PK / FK / UQ = primary, foreign, unique key. Black column = NOT NULL, grey = nullable.&lt;br&gt;&amp;#8594; table = foreign key not drawn as a line (mostly &amp;#8216;who did it&amp;#8217; columns to app_user).&lt;br&gt;lifecycle_event (previous_state, event_type, new_state) &amp;#8594; allowed_transition is one composite foreign key (the A3 transition table).&lt;br&gt;No column stores coordinates, an address or a CNIC (privacy scan in test_schema.py)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10.5;fontStyle=0;fontColor=#1d1d1d;spacing=2;overflow=visible;" vertex="1" parent="1">
          <mxGeometry x="50" y="1146" width="720" height="158" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
